{
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "parsableStyle": true,
    "compress": false,
    "headerText": "AI Notes Manager - Full Project Audit Source"
  },
  "include": [
    "frontend/src/**",
    "backend/**",
    "functions/**",
    "firebase.json",
    "firestore.rules",
    "firestore.indexes.json",
    "package.json",
    "frontend/package.json",
    "backend/package.json",
    "vite.config.*",
    "render.yaml"
  ],
  "ignore": {
    "customPatterns": [
      "node_modules/**",
      "frontend/node_modules/**",
      "backend/node_modules/**",
      "functions/node_modules/**",
      "dist/**",
      "frontend/dist/**",
      "build/**",
      ".git/**",
      "coverage/**",
      ".env",
      ".env.*",
      "**/.env",
      "**/.env.*",
      "**/*serviceAccount*.json",
      "**/*service-account*.json",
      "**/serviceAccountKey.json",
      "repomix-output.xml"
    ]
  }
}